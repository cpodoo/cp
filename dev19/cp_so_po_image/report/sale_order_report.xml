<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_report_inherit_id" inherit_id="sale.report_saleorder_document">

        <!-- Define variable to check system parameter -->
        <xpath expr="//div[@class='page']" position="before">
            <t t-set="show_image"
               t-value="request.env['ir.config_parameter'].sudo().get_param('cp_so_po_image.sale_product_image_report') == 'True'"/>
        </xpath>

        <!-- Add "No." column header before the first column -->
        <xpath expr="//table[contains(@class, 'o_main_table')]/thead/tr/th[1]" position="before">
            <th class="text-start">No.</th>
        </xpath>

        <!-- Add "Image" column header after the first column -->
        <xpath expr="//table[contains(@class, 'o_main_table')]/thead/tr/th[1]" position="after">
            <th class="text-center" t-if="show_image">Image</th>
        </xpath>

        <!-- Add "No." cell before first cell in each order line row -->
        <xpath expr="//t[@t-foreach='lines_to_report']//td[@name='td_product_name']" position="before">
            <td class="text-start">
                <span t-esc="line.seq_no"/>
            </td>
        </xpath>

        <!-- Add product image cell after product name/description -->
        <xpath expr="//t[@t-foreach='lines_to_report']//td[@name='td_product_name']" position="after">
            <t t-if="show_image">
                <td style="height:100px !important;width:100px !important;">
                    <img t-att-src="image_data_uri(line.product_id.image_1920)" class="img-fluid"/>
                </td>
            </t>
        </xpath>

    </template>
</odoo>