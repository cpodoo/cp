<odoo>
    <template id="sale_report_inherit_id" inherit_id="sale.report_saleorder_document">

        <!-- Add "No." column header before the first column -->
        <xpath expr="//table[contains(@class, 'o_main_table')]/thead/tr/th[1]" position="before">
            <th class="text-start">No.</th>
        </xpath>

        <!-- Add "Image" column header after the first column -->
        <xpath expr="//table[contains(@class, 'o_main_table')]/thead/tr/th[1]" position="after">
            <th class="text-center">Image</th>
        </xpath>

